<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PlatformTarget>x64</PlatformTarget>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LocalPluginPath>D:\cs2_srv\game\csgo\addons\swiftlys2\plugins\CS2KZEvents</LocalPluginPath>
	</PropertyGroup>

	<ItemGroup Condition="'$(CI)' != 'true'">
		<Reference Include="SwiftlyS2.CS2">
			<HintPath>D:\cs2_srv\game\csgo\addons\swiftlys2\bin\managed\SwiftlyS2.CS2.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup Condition="'$(CI)' == 'true'">
		<PackageReference Include="SwiftlyS2.CS2" Version="1.2.2" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
		<ProjectReference Include="../CS2KZEvents.Shared/CS2KZEvents.Shared.csproj" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(CI)' != 'true'">
		<Exec Command="if not exist &quot;$(LocalPluginPath)\resources\exports&quot; mkdir &quot;$(LocalPluginPath)\resources\exports&quot;" />
		<Exec Command="move /Y &quot;$(OutDir)CS2KZEvents.Shared.*&quot; &quot;$(LocalPluginPath)\resources\exports\&quot;" />
		<Exec Command="xcopy /Y /I &quot;$(OutDir)$(ProjectName).*&quot; &quot;$(LocalPluginPath)\&quot;" />
		<Exec Command="del /F /Q &quot;$(LocalPluginPath)\CS2KZEvents.Shared.*&quot;" ContinueOnError="true" />
	</Target>

	<Target Name="PostBuildCI" AfterTargets="PostBuildEvent" Condition="'$(CI)' == 'true'">
		<Exec Command="if not exist &quot;$(CI_OUTPUT_DIR)\resources\exports&quot; mkdir &quot;$(CI_OUTPUT_DIR)\resources\exports&quot;" />
		<Exec Command="move /Y &quot;$(OutDir)CS2KZEvents.Shared.*&quot; &quot;$(CI_OUTPUT_DIR)\resources\exports\&quot;" />
		<Exec Command="xcopy /Y /I &quot;$(OutDir)$(ProjectName).*&quot; &quot;$(CI_OUTPUT_DIR)&quot;" />
		<Exec Command="del /F /Q &quot;$(CI_OUTPUT_DIR)\CS2KZEvents.Shared.*&quot;" ContinueOnError="true" />
	</Target>

</Project>
